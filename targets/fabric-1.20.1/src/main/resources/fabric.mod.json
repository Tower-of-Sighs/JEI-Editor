{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["cc.sighs.JEIEditor.JEIEditorFabric"],
    "client": ["cc.sighs.JEIEditor.JEIEditorFabricClient"],
